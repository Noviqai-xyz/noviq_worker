# Noviq seed fleet config. Copy to .env and fill in. NEVER commit .env.

# Orchestrator the seed workers connect to (WebSocket control plane).
ORCHESTRATOR_WS_URL=wss://orchestrator.noviqai.xyz/v1/worker
# HTTP base for token provisioning (defaults to the WS host over https).
# ORCHESTRATOR_HTTP_URL=https://orchestrator.noviqai.xyz

# Local Ollama the workers run models against.
OLLAMA_HOST=http://127.0.0.1:11434

# Pull models via Ollama if they aren't installed yet (1 = on).
AUTO_PULL=1

# --- Worker tokens: pick ONE of the two approaches ---

# (A) Auto-provision: set the orchestrator's ADMIN_SECRET here and the fleet
# will mint one seed token per instance on first boot and cache them in
# .tokens.json (reused on restart).
ADMIN_SECRET=

# (B) Manual: paste worker tokens (comma-separated), one per instance. Create
# them on https://noviqai.xyz/earn (native worker) or via the admin endpoint.
# Takes precedence over auto-provisioning when set.
# NOVIQ_WORKER_TOKENS=nvq_aaa,nvq_bbb

# Optional: path to the fleet config (default ./fleet.config.json)
# FLEET_CONFIG=./fleet.config.json
